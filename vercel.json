{
  "version": 2,
  "framework": "vite",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/Logo.png", "destination": "/Logo.png" },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "app.tradingprobrasil.com" }],
      "destination": "/frontend-app/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/landinpagecalculadora/index.html"
    }
  ]
}