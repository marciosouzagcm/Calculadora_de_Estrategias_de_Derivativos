{
  "version": 2,
  "framework": "vite",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/Logo.png", "destination": "/Logo.png" },
    { 
      "source": "/api/(.*)", 
      "destination": "https://calculadora-de-estrategias-de-derivativos.onrender.com/api/$1" 
    },
    {
      "source": "/app",
      "destination": "/frontend-app/index.html"
    },
    {
      "source": "/app/(.*)",
      "destination": "/frontend-app/index.html"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.tradingprobrasil.com" }],
      "destination": "/landingpagecalculadora/index.html"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "tradingprobrasil.com" }],
      "destination": "/landingpagecalculadora/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/landingpagecalculadora/index.html"
    }
  ]
}