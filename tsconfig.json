{
  "compilerOptions": {
    /* Configurações de Módulo e Alvo */
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "isolatedModules": true,

    /* Mapeamento de Alias (ESSENCIAL para o @/ funcionar) */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Configurações de Emissão */
    "outDir": "./dist",
    "rootDir": "./", 
    "noEmit": false, 
    
    /* Rigor e Performance */
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules", 
    "dist", 
    "frontend-app"
  ]
}